# =============================================================================
# Solaris Reef Environment Configuration (.env.example)
#
# IMPORTANT: In production on Cloudflare Pages, all sensitive secrets must be
# configured using Cloudflare Pages Secrets (wrangler secret put <NAME> or via the
# Cloudflare Pages dashboard) and NEVER committed to version control.
# =============================================================================

# Billplz Payment Gateway Configuration (Malaysian Ringgit, MYR)
# Production secrets:
BILLPLZ_API_KEY="CHANGE_ME_billplz_api_key"
BILLPLZ_COLLECTION_ID="CHANGE_ME_billplz_collection_id"
BILLPLZ_X_SIGNATURE_KEY="CHANGE_ME_billplz_x_signature_key"

# Optional Billplz Environment Variables:
# Set to 'false' for Production (https://www.billplz.com/api/v3)
# Set to 'true' to use Billplz Staging/Sandbox (https://www.billplz-sandbox.com/api/v3)
BILLPLZ_SANDBOX="false"

# Payment Simulation:
# Explicit flag (default off). Must equal the exact string "true" to enable mock checkouts.
ENABLE_PAYMENT_SIMULATION="true"

# Administrator Authentication (Required Secrets in Cloudflare Pages)
# ADMIN_EMAIL and ADMIN_PASSWORD are required for bootstrapping admin access.
# ADMIN_PASSWORD must be at least 12 characters.
# SESSION_SECRET must be at least 32 characters (HMAC-SHA256 session token key).
ADMIN_EMAIL="CHANGE_ME_admin_email@example.org"
ADMIN_PASSWORD="CHANGE_ME_min_12_chars"
SESSION_SECRET="CHANGE_ME_min_32_chars_random"

# Optional CORS allowed origins (comma-separated origins besides the site's own origin)
ALLOWED_ORIGINS=""

# Cloudflare Pages / CI Build Environment Variables
BUN_VERSION="1.2.4"
NODE_VERSION="20.18.0"
