# =============================================================================
# Solaris Reef Campaign Hub — Environment Configuration Template
# Copy this file to .env for local development.
# IMPORTANT: Never commit actual production secrets or credentials to source control.
# =============================================================================

# Server Environment
NODE_ENV=development
PORT=3000

# Canonical Application URL
# Used to construct tamper-proof redirect and callback URLs for payment gateways
CANONICAL_APP_URL=http://localhost:3000

# Authentication & Session Security
# SESSION_SECRET must be at least 32 characters in production
SESSION_SECRET=your_development_session_secret_min_32_characters_here

# Administrator Credentials (Provisioned securely via environment secrets)
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=your_secure_development_admin_password
# In production, use precomputed PBKDF2 hash & salt:
# ADMIN_PASSWORD_HASH=
# ADMIN_SALT=

# Billplz Payment Gateway Configuration
# Live payments remain disabled until genuine credentials are provided
BILLPLZ_API_KEY=your_billplz_api_key_here
BILLPLZ_COLLECTION_ID=your_billplz_collection_id_here
BILLPLZ_X_SIGNATURE_KEY=your_billplz_x_signature_key_here
BILLPLZ_SANDBOX=true

# Payment Simulation
# Enables local simulator UI for offline testing; strictly rejected in production builds
ENABLE_PAYMENT_SIMULATION=true

# Email Service (Resend API)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="Solaris Reef Campaign <receipts@solaris-reef.org>"

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
